            />
          </svg>
        </a>
        {% if site.linkedin_username %}
          <a
            href="https://www.linkedin.com/in/{{ site.linkedin_username }}"
            title="LinkedIn"
            aria-label="LinkedIn"
            target="_blank"
            rel="noopener"
          >
            <svg class="profile-icon icon-linkedin" viewBox="0 0 448 448" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M92 448H16V152H92ZM54 102A44 44 0 1 1 54 14A44 44 0 1 1 54 102ZM440 448H364V298C364 256 349 218 304 218C263 218 244 246 244 296V448H168V152H241V193H242C254 169 284 144 331 144C398 144 440 187 440 279Z"
              />
            </svg>
          </a>
        {% endif %}
      </div>

      <ul class="navbar-nav ml-auto flex-row">
        {% for p in site.pages %}
          {% if p.permalink == '/' %}
            {% assign about_title = p.title %}
          {% endif %}
        {% endfor %}

        <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
          <a class="nav-link" href="{{ '/' | relative_url }}" {% if page.permalink == '/' %}aria-current="page"{% endif %}>
            {{- about_title -}}
          </a>
        </li>

        {% assign sorted_pages = site.pages | sort: 'nav_order' %}
        {% for p in sorted_pages %}
          {% if p.nav and p.autogen == null %}
            {% assign parent_link = p.permalink | remove: 'index.html' %}
            <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
              {% if p.nav_url %}
                {% assign nav_href = p.nav_url %}
              {% elsif p.permalink contains '://' %}
                {% assign nav_href = p.permalink %}
              {% elsif p.permalink contains '/blog/' %}
                {% assign nav_href = '/blog/' %}
              {% else %}
                {% assign nav_href = p.url %}
              {% endif %}
              <a
                class="nav-link"
                href="{{ nav_href | relative_url }}"
                {% if nav_href contains '.pdf' %}target="_blank" rel="noopener"{% endif %}
                {% if page.url contains parent_link %}aria-current="page"{% endif %}
              >
                {{- p.title -}}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </nav>
</header>
