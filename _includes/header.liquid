<header class="site-header">
  <nav id="navbar" class="navbar navbar-light {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="Primary">
    <div class="container nav-inner">
      <div class="profile-links" aria-label="Contact and academic profiles">
        {% if site.email %}
          <a
            href="mailto:{{ site.email }}"
            title="{{ site.email }}"
            aria-label="Email {{ site.email }}"
          >
            <svg class="profile-icon icon-email" viewBox="0 0 512 384" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M64 48c-8.8 0-16 7.2-16 16v22.1L220.5 227.7c20.7 17 50.4 17 71.1 0L464 86.1V64c0-8.8-7.2-16-16-16H64zM48 148.2V320c0 8.8 7.2 16 16 16H448c8.8 0 16-7.2 16-16V148.2L322 264.8c-38.4 31.5-93.7 31.5-132 0L48 148.2zM0 64C0 28.7 28.7 0 64 0H448c35.3 0 64 28.7 64 64V320c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V64z"
              />
            </svg>
          </a>
        {% endif %}
        <a
          href="{{ site.work_url | default: 'https://profiles.imperial.ac.uk/j.wu' }}"
          title="Imperial Profile"
          aria-label="Imperial Profile"
          target="_blank"
          rel="noopener"
        >
          <svg class="profile-icon icon-imperial" viewBox="0 0 512 512" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M243.4 2.6l-224 96c-14 6-21.8 21-18.7 35.8S16.8 160 32 160v8c0 13.3 10.7 24 24 24H456c13.3 0 24-10.7 24-24v-8c15.2 0 28.3-10.7 31.3-25.6s-4.8-29.9-18.7-35.8l-224-96c-8-3.4-17.2-3.4-25.2 0zM128 224H64V420.3c-.6 .3-1.2 .7-1.8 1.1l-48 32c-11.7 7.8-17 22.4-12.9 35.9S17.9 512 32 512H480c14.1 0 26.5-9.2 30.6-22.7s-1.1-28.1-12.9-35.9l-48-32c-.6-.4-1.2-.7-1.8-1.1V224H384V416H344V224H280V416H232V224H168V416H128V224zM256 64a32 32 0 1 1 0 64 32 32 0 1 1 0-64z"
            />
          </svg>
        </a>
        {% if site.scholar_userid %}
          <a
            href="https://scholar.google.com/citations?user={{ site.scholar_userid }}&hl=en"
            title="Google Scholar"
            aria-label="Google Scholar"
            target="_blank"
            rel="noopener"
          >
            <svg class="profile-icon icon-scholar" viewBox="0 0 344 384" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M324 43Q330 44 330 53V182Q330 185 328.5 187.5Q327 190 324.5 191.5Q322 193 319 193H315Q313 193 310.5 191.5Q308 190 306.5 187.5Q305 185 305 182V53Q305 43 311 43V26L254 72Q255 73 255 74Q256 75 256 75Q264 89 264 109Q264 124 258.5 136.5Q253 149 246 156.5Q239 164 231.5 170.5Q224 177 218.5 184Q213 191 213 198Q213 205 220 212.5Q227 220 237 228Q246 235 256 244Q266 252 272.5 266Q279 280 279 296Q279 318 268 335.5Q257 353 239 363.5Q221 374 201 379Q181 384 161 384Q148 384 135 382Q122 380 109 375Q96 370 86 362.5Q76 355 69.5 343.5Q63 332 63 317Q63 300 72.5 285.5Q82 271 98 261Q126 244 184 240Q171 223 171 208Q171 200 175 190Q168 191 161 191Q129 191 107.5 170.5Q86 150 86 118Q86 115 86 112H0L130 0H344L324 15ZM200 253Q196 252 190 252Q175 252 161 255Q147 258 133.5 263.5Q120 269 111.5 280.5Q103 292 103 308Q103 322 110.5 333.5Q118 345 130 351.5Q142 358 155 361Q169 365 182 365Q210 365 229.5 352.5Q249 340 249 314Q249 309 247.5 304Q246 299 244.5 295Q243 291 239 286Q235 282 232 279Q230 276 224 271Q218 266 216.5 265Q215 264 208 259Q201 254 200 253ZM224 131Q224 114 218 95Q212 76 198.5 61Q185 46 167 46Q147 46 136.5 60.5Q126 75 126 95Q126 113 131.5 131Q137 149 150.5 163.5Q164 178 182 178Q202 178 213 164.5Q224 151 224 131Z"
              />
