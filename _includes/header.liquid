          </a>
        {% endif %}
        <a
          href="https://papers.ssrn.com/sol3/cf_dev/AbsByAuth.cfm?per_id={{ site.ssrn_id | default: '1671980' }}"
          title="SSRN"
          aria-label="SSRN"
          target="_blank"
          rel="noopener"
        >
          <svg class="profile-icon icon-ssrn" viewBox="0 0 508 208" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              stroke="currentColor"
              stroke-width="5.5"
              stroke-linejoin="round"
