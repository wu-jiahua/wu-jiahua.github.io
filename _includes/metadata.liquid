{% if site.enable_google_verification and site.google_site_verification %}
  <meta name="google-site-verification" content="{{ site.google_site_verification }}">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% assign author_name = author_name | strip %}
{% if site.title == 'blank' %}
  {% assign title = author_name %}
{% else %}
  {% assign title = site.title | strip %}
{% endif %}
{% if page.title != 'blank' and page.url != '/' and page.permalink != '/' %}
  {% if page.title == null or page.title == '' %}
    {% capture meta_title %}{{ page.date | date: '%Y' }} | {{ title }}{% endcapture %}
  {% else %}
    {% capture meta_title %}{{ page.title }} | {{ title }}{% endcapture %}
  {% endif %}
{% else %}
  {% assign meta_title = title %}
{% endif %}
{% assign meta_title = meta_title | strip %}
{% assign meta_description = page.description | default: site.description | strip %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title>{{ meta_title }}</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ meta_description }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ title }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ meta_title }}">
  <meta property="og:url" content="{{ page.url | prepend: site.baseurl | prepend: site.url | remove_first: 'index.html' }}">
  <meta property="og:description" content="{{ meta_description }}">
  {% if page.og_image or site.og_image %}
    <meta property="og:image" content="{% if page.og_image %}{{ page.og_image }}{% else %}{{ site.og_image }}{% endif %}">
  {% endif %}
  <meta property="og:locale" content="{{ site.lang }}">

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ meta_title }}">
  <meta name="twitter:description" content="{{ meta_description }}">
  {% if page.og_image or site.og_image %}
    <meta name="twitter:image" content="{% if page.og_image %}{{ page.og_image }}{% else %}{{ site.og_image }}{% endif %}">
  {% endif %}
  {% if site.x_username %}
    <meta name="twitter:site" content="@{{ site.x_username }}">
    <meta name="twitter:creator" content="@{{ site.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org -->
  {% assign sameaslinks = '' | split: ',' %}
  {% if site.orcid_id %}
    {% capture link %}https://orcid.org/{{ site.orcid_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.scholar_userid %}
    {% capture link %}https://scholar.google.com/citations?user={{ site.scholar_userid }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.linkedin_username %}
    {% capture link %}https://www.linkedin.com/in/{{ site.linkedin_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.work_url %}
    {% capture link %}{{ site.work_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.ssrn_id %}
    {% capture link %}https://papers.ssrn.com/sol3/cf_dev/AbsByAuth.cfm?per_id={{ site.ssrn_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.github_username %}
    {% capture link %}https://github.com/{{ site.github_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.x_username %}
    {% capture link %}https://x.com/{{ site.x_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "{% if page.permalink == '/' %}Person{% else %}WebPage{% endif %}",
      "name": {{ author_name | strip | jsonify }},
      {% if page.permalink == '/' %}
      "jobTitle": "Associate Professor of Operations",
      "affiliation": {
        "@type": "Organization",
        "name": "Imperial Business School, Imperial College London",
        "url": "https://www.imperial.ac.uk/business-school/"
      },
      "email": {{ site.email | jsonify }},
      "image": {{ site.og_image | jsonify }},
      {% else %}
      "headline": {{ page.title | default: site.title | jsonify }},
      "author": {
        "@type": "Person",
        "name": {{ author_name | strip | jsonify }},
        "url": {{ site.url | append: site.baseurl | append: '/' | jsonify }}
      },
      {% endif %}
      "url": {{ page.url | prepend: site.baseurl | prepend: site.url | remove_first: 'index.html' | jsonify }},
      "description": {{ meta_description | jsonify }}{% if sameaslinks.size > 0 %},
      "sameAs": {{ sameaslinks | jsonify }}{% endif %}
    }
  </script>
{% endif %}
