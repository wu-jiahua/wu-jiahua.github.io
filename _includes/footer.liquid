<footer class="site-footer" role="contentinfo">
  <div class="container">
    <p class="footer-copy">
      &copy; {{ site.time | date: '%Y' }} {{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}
      {% if site.footer_text != blank %}
        &middot; {{ site.footer_text }}
      {% else %}
        &middot; Design inspired by <a href="https://github.com/Yanwei-Sun/html-slide" target="_blank" rel="noopener">html-slide</a> by <a href="https://yanwei-sun.github.io/" target="_blank" rel="noopener">Yanwei Sun</a>
      {% endif %}
    </p>
  </div>
</footer>
