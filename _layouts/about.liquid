---
layout: default
---
<div class="post about-page">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <div class="title-rule" aria-hidden="true"></div>
    {% if page.subtitle %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <article class="about-grid">
    <div class="about-main">
      {{ content }}
    </div>

    {% if page.profile and page.profile.image %}
      <aside class="about-aside" aria-label="Portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        <div class="portrait-frame">
          {%
            include figure.liquid loading="eager" fetchpriority="high" path=profile_image_path class="portrait-img" alt="Jiahua Wu"
            cache_bust=true width=800 height=1200
          %}
        </div>
      </aside>
    {% endif %}
  </article>
</div>
