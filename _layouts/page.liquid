---
layout: default
---
<div class="post page-view{% if page.permalink == '/research/' %} research-page{% endif %}">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <div class="title-rule" aria-hidden="true"></div>
    {% if page.description and page.hide_header_description != true %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article class="page-article{% if page.permalink == '/research/' %} research-content{% endif %}">
    {{ content }}
  </article>
</div>
